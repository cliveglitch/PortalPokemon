@{
    ViewData["Title"] = "Home Page";
}

@model PokePortalModel

@if (TempData["ToastMessage"] is string message)
{
    <div class="email-toast @TempData["ToastType"]" role="status">
        <span>@message</span>

        <button type="button"
                aria-label="Cerrar"
                onclick="this.parentElement.remove()">
            ×
        </button>
    </div>
}

@if (Model is not null)
{
    var grid = Model.PokemonGrid;
    var currentPage = grid.Offset / grid.Limit + 1;
    var totalPages = (int)Math.Ceiling(grid.Count / (double)grid.Limit);

    var pages = Enumerable.Range(1, totalPages)
        .Where(page => page == 1
            || page == totalPages
            || Math.Abs(page - currentPage) <= 2);

    string? PageUrl(int page) => Url.Action("Paginated", "Pokemon", new
    {
        limit = grid.Limit,
        offset = (page - 1) * grid.Limit,
        nameFilter = Model.NameFilter,
        speciesFilter = Model.SpeciesFilter
    });

    var previousPage = 0;

    <pre id="pokemon-debug" style="display: none;">@System.Text.Json.JsonSerializer.Serialize(Model)</pre>

    <script>
        const jsonText = document.getElementById("pokemon-debug").textContent;
        const pokemon = JSON.parse(jsonText);

        console.log(pokemon);
    </script>

    <div class="pokemon-toolbar">
        @* Filters *@
        <form method="get" action="/" class="pokemon-search">
            <label for="pokemon-name">Nombre</label>
            <div class="search-bar">
                <input type="search"
                       id="pokemon-name"
                       name="nameFilter"
                       value="@Model.NameFilter" />

                <button type="submit">Buscar</button>
            </div>

            <div class="species-filter">
                <label for="pokemon-species">Especie</label>

                <select id="pokemon-species" name="speciesFilter">
                    <option value="">Todas las especies</option>

                    @foreach (var species in Model.AvailableSpecies)
                    {
                        <option value="@species"
                                selected="@(species == Model.SpeciesFilter)">
                            @species
                        </option>
                    }
                </select>
            </div>

            <a asp-controller="Pokemon"
               asp-action="ExportToExcel"
               asp-route-nameFilter="@Model.NameFilter"
               asp-route-speciesFilter="@Model.SpeciesFilter"
               asp-route-limit="@Model.PokemonGrid.Limit"
               asp-route-offset="@Model.PokemonGrid.Offset"
               class="export-button">
                Descargar Excel
            </a>

            <input type="hidden" name="limit" value="@Model.PokemonGrid.Limit" />
            <input type="hidden" name="offset" value="0" />

        </form>

        @* Email *@
        <form asp-controller="Pokemon"
              asp-action="SendManyEmail"
              method="post"
              asp-antiforgery="true"
              class="pokemon-email">

            <label for="recipient-email">Correo</label>

            <div class="email-controls">
                <input type="email"
                       id="recipient-email"
                       name="recipientEmail"
                       value="@TempData["RecipientEmail"]"
                       placeholder="correo@ejemplo.com"
                       autocomplete="email"
                       required />

                <button type="submit">Enviar página</button>
            </div>

            <input type="hidden" name="limit" value="@Model.PokemonGrid.Limit" />
            <input type="hidden" name="offset" value="@Model.PokemonGrid.Offset" />
            <input type="hidden" name="nameFilter" value="@Model.NameFilter" />
            <input type="hidden" name="speciesFilter" value="@Model.SpeciesFilter" />

        </form>
    </div>


    <div class="pokemon-grid">
        @foreach (var pokemon in Model.PokemonGrid.Pokemons)
        {
            <partial name="_PokemonCard" model="pokemon" />
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="pagination-controls" aria-label="Páginas de Pokémon">
            @if (grid.HasPrevious)
            {
                <a href="@PageUrl(currentPage - 1)">Anterior</a>
            }
            else
            {
                <span class="pagination-disabled" aria-disabled="true">Anterior</span>
            }

            @foreach (var pageNumber in pages)
            {
                if (pageNumber > previousPage + 1)
                {
                    <span class="pagination-ellipsis" aria-hidden="true">…</span>
                }

                if (pageNumber == currentPage)
                {
                    <span class="pagination-current" aria-current="page">@pageNumber</span>
                }
                else
                {
                    <a href="@PageUrl(pageNumber)"
                       aria-label="Página @pageNumber">@pageNumber</a>
                }

                previousPage = pageNumber;
            }

            @if (grid.HasNext)
            {
                <a href="@PageUrl(currentPage + 1)">Siguiente</a>
            }
            else
            {
                <span class="pagination-disabled" aria-disabled="true">Siguiente</span>
            }
        </nav>
    }
}

