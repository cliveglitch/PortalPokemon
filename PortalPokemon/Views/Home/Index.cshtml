@{
    ViewData["Title"] = "Home Page";
}

@model PokePortalModel

@if (Model is not null)
{
    <pre id="pokemon-debug" style="display: none;">@System.Text.Json.JsonSerializer.Serialize(Model)</pre>

    <script>
        const jsonText = document.getElementById("pokemon-debug").textContent;
        const pokemon = JSON.parse(jsonText);

        console.log(pokemon);
    </script>

    <form method="get" action="/" class="pokemon-search">
        <label for="pokemon-name">Name</label>
        <div class="search-bar">
            <input type="search"
                   id="pokemon-name"
                   name="nameFilter"
                   value="@Model.NameFilter"
                   placeholder="Search Pokémon…" />

            <button type="submit">Search</button>
        </div>

        <div class="species-filter">
            <label for="pokemon-species">Species</label>

            <select id="pokemon-species" name="speciesFilter">
                <option value="">All species</option>

                @foreach (var species in Model.AvailableSpecies)
                {
                    <option value="@species"
                            selected="@(species == Model.SpeciesFilter)">
                        @species
                    </option>
                }
            </select>
        </div>

        <input type="hidden" name="limit" value="@Model.PokemonGrid.Limit" />
        <input type="hidden" name="offset" value="0" />

    </form>

    <div class="pokemon-grid">
        @foreach (var pokemon in Model.PokemonGrid.Pokemons)
        {
            <partial name="_PokemonCard" model="pokemon" />
        }
    </div>

    <nav class="pagination-controls" aria-label="Pokémon pages">
        @if (Model.PokemonGrid.HasPrevious)
        {
            <a asp-controller="Pokemon"
               asp-action="Paginated"
               asp-route-nameFilter="@Model.NameFilter"
               asp-route-speciesFilter="@Model.SpeciesFilter"
               asp-route-limit="@Model.PokemonGrid.Limit"
               asp-route-offset="@(Math.Max(0, Model.PokemonGrid.Offset - Model.PokemonGrid.Limit))">
                Previous
            </a>
        } else
        {
            <span class="pagination-disabled" role="link" aria-disabled="true">
                Previous
            </span>
        }

        @if (Model.PokemonGrid.HasNext)
        {
            <a asp-controller="Pokemon"
               asp-action="Paginated"
               asp-route-nameFilter="@Model.NameFilter"
               asp-route-speciesFilter="@Model.SpeciesFilter"
               asp-route-limit="@Model.PokemonGrid.Limit"
               asp-route-offset="@(Model.PokemonGrid.Offset + Model.PokemonGrid.Limit)">
                Next
            </a>
        } else
        {
            <span class="pagination-disabled" role="link" aria-disabled="true">
                Next
            </span>
        }
    </nav>
}

