@{
    ViewData["Title"] = "Home Page";
}

@model PaginatedPokemonModel

@if (Model is not null)
{
    <pre id="pokemon-debug" style="display: none;">@System.Text.Json.JsonSerializer.Serialize(Model)</pre>

    <script>
        const jsonText = document.getElementById("pokemon-debug").textContent;
        const pokemon = JSON.parse(jsonText);

        console.log(pokemon);
    </script>

    <div class="pokemon-grid">
        @foreach (var pokemon in Model.Pokemons)
        {
            <partial name="_PokemonCard" model="pokemon" />
        }
    </div>

    <nav class="pagination-controls" aria-label="Pokémon pages">
        @if (Model.Previous is not null)
        {
            <a href="/?limit=@Model.Limit&offset=@(Math.Max(0, Model.Offset - Model.Limit))">Previous</a>
        } else
        {
            <span class="pagination-disabled" role="link" aria-disabled="true">
                Previous
            </span>
        }

        @if (Model.Next is not null)
        {
            <a href="/?limit=@Model.Limit&offset=@(Model.Offset + Model.Limit)">Next</a>
        } else
        {
            <span class="pagination-disabled" role="link" aria-disabled="true">
                Next
            </span>
        }
    </nav>
}

